# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.

# Postgres (defaults match docker-compose)
DATABASE_URL=postgresql+asyncpg://horeca:horeca@db:5432/horeca

# Cloudinary — dish photos & restaurant logos are uploaded here and only the
# resulting secure URL is stored in the database. Grab these from your
# Cloudinary dashboard (Settings -> API Keys).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
